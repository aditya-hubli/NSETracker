# ==============================================
# EVENT-DRIVEN DATA PLATFORM - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ==============================================

# ---------------------------------------------
# Service Configuration
# ---------------------------------------------
SERVICE_NAME=event-platform
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------
# Kafka/Redpanda Configuration
# ---------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Topic names
TOPIC_USERS=events.users
TOPIC_ORDERS=events.orders
TOPIC_PAYMENTS=events.payments
TOPIC_DLQ=events.dlq

# Consumer settings
CONSUMER_GROUP_ID=event-processor-group
CONSUMER_AUTO_OFFSET_RESET=earliest

# Producer settings
PRODUCER_ACKS=all
PRODUCER_RETRIES=3

# ---------------------------------------------
# Supabase (PostgreSQL) Configuration
# ---------------------------------------------
# Get these from: Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Get this from: Supabase Dashboard -> Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------
# API Configuration
# ---------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# CORS settings (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------
# Next.js Dashboard Configuration
# ---------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------
# Storage Configuration
# ---------------------------------------------
PARQUET_STORAGE_PATH=./data/parquet

# ---------------------------------------------
# Cache Configuration (in-memory, no external service needed)
# ---------------------------------------------
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# ---------------------------------------------
# External API Keys (for sentiment analysis)
# ---------------------------------------------
# NewsAPI - https://newsapi.org/
NEWS_API_KEY=your-newsapi-key

# Reddit API - https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=StockSentimentBot/1.0

# Twitter API (optional) - https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# ---------------------------------------------
# JWT Configuration (NEW)
# ---------------------------------------------
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ---------------------------------------------
# ML/AI Model Configuration (for future deployment)
# ---------------------------------------------
# Set to true when ML models are deployed to the models volume
ENABLE_ML_PREDICTIONS=false
ENABLE_ML_SENTIMENT=false
ML_MODEL_PATH=/app/models

# ---------------------------------------------
# Microservice URLs (for Docker networking)
# ---------------------------------------------
USER_SERVICE_URL=http://user-service:8001
ANALYTICS_SERVICE_URL=http://analytics-service:8002
SENTIMENT_SERVICE_URL=http://sentiment-service:8003
STOCK_SERVICE_URL=http://stock-service:8004
NOTIFICATION_SERVICE_URL=http://notification-service:8005

# ---------------------------------------------
# Email Configuration (for notifications)
# ---------------------------------------------
# Enable email notifications
EMAIL_ENABLED=true

# RECOMMENDED: Use Resend (free, easy setup)
# 1. Sign up at https://resend.com (free tier: 100 emails/day)
# 2. Create an API key
# 3. Add it here:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Sender name (shown in emails)
SMTP_FROM_NAME=Stock Platform Alerts

# ALTERNATIVE: Use SMTP (more complex setup)
# Only needed if NOT using Resend
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
