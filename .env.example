# ==============================================
# EVENT-DRIVEN DATA PLATFORM - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ==============================================

# ---------------------------------------------
# Service Configuration
# ---------------------------------------------
SERVICE_NAME=event-platform
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------
# Kafka/Redpanda Configuration
# ---------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Topic names
TOPIC_USERS=events.users
TOPIC_ORDERS=events.orders
TOPIC_PAYMENTS=events.payments
TOPIC_DLQ=events.dlq

# Consumer settings
CONSUMER_GROUP_ID=event-processor-group
CONSUMER_AUTO_OFFSET_RESET=earliest

# Producer settings
PRODUCER_ACKS=all
PRODUCER_RETRIES=3

# ---------------------------------------------
# Supabase (PostgreSQL) Configuration
# ---------------------------------------------
# Get these from: Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Get this from: Supabase Dashboard -> Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------
# API Configuration
# ---------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# CORS settings (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------
# Next.js Dashboard Configuration
# ---------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------
# Storage Configuration
# ---------------------------------------------
PARQUET_STORAGE_PATH=./data/parquet
